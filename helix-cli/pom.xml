<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.helix</groupId>
    <artifactId>helix-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>helix-cli</artifactId>
  <name>Helix CLI</name>

  <dependencies>
    <dependency>
      <groupId>io.helix</groupId>
      <artifactId>helix-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.helix</groupId>
      <artifactId>helix-investigations</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.helix</groupId>
      <artifactId>helix-reporter-json</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.helix</groupId>
      <artifactId>helix-reporter-text</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.helix</groupId>
      <artifactId>helix-parser-hprof</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.helix</groupId>
      <artifactId>helix-parser-threaddump</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.helix</groupId>
      <artifactId>helix-parser-gclog</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.helix</groupId>
      <artifactId>helix-parser-jfr</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.helix</groupId>
      <artifactId>helix-parser-crashlog</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.helix</groupId>
      <artifactId>helix-analyzer-memory</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.helix</groupId>
      <artifactId>helix-analyzer-threads</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.helix</groupId>
      <artifactId>helix-analyzer-gc</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.helix</groupId>
      <artifactId>helix-analyzer-jfr</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.helix</groupId>
      <artifactId>helix-analyzer-crash</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.helix</groupId>
      <artifactId>helix-correlation</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.helix</groupId>
      <artifactId>helix-agent-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.helix</groupId>
      <artifactId>helix-agent-memory</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.helix</groupId>
      <artifactId>helix-agent-threads</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.helix</groupId>
      <artifactId>helix-agent-gc</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.helix</groupId>
      <artifactId>helix-agent-jfr</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.helix</groupId>
      <artifactId>helix-agent-correlation</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.helix</groupId>
      <artifactId>helix-agent-narrative</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.helix</groupId>
      <artifactId>helix-reasoning</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>info.picocli</groupId>
      <artifactId>picocli</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifest>
              <mainClass>io.helix.cli.HelixMain</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>io.helix.cli.HelixMain</mainClass>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
