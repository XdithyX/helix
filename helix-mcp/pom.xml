<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.helix</groupId>
    <artifactId>helix-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>helix-mcp</artifactId>
  <name>Helix MCP Server</name>

  <properties>
    <!-- MCP 2.0.0's Jackson 2 adapter is compiled against the 2.20 line. -->
    <jackson.version>2.20.1</jackson.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.fasterxml.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>${jackson.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>io.helix</groupId>
      <artifactId>helix-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.helix</groupId>
      <artifactId>helix-agent-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.helix</groupId>
      <artifactId>helix-investigations</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.helix</groupId>
      <artifactId>helix-parser-hprof</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.helix</groupId>
      <artifactId>helix-parser-threaddump</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.helix</groupId>
      <artifactId>helix-parser-gclog</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.helix</groupId>
      <artifactId>helix-parser-jfr</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.helix</groupId>
      <artifactId>helix-parser-crashlog</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.helix</groupId>
      <artifactId>helix-analyzer-memory</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.helix</groupId>
      <artifactId>helix-analyzer-threads</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.helix</groupId>
      <artifactId>helix-analyzer-gc</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.helix</groupId>
      <artifactId>helix-analyzer-jfr</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.helix</groupId>
      <artifactId>helix-analyzer-crash</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.helix</groupId>
      <artifactId>helix-correlation</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.modelcontextprotocol.sdk</groupId>
      <artifactId>mcp-core</artifactId>
    </dependency>
    <dependency>
      <groupId>io.modelcontextprotocol.sdk</groupId>
      <artifactId>mcp-json-jackson2</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <!-- Shade replaces the main artifact; always recreate its thin input first. -->
          <forceCreation>true</forceCreation>
          <archive>
            <manifest>
              <mainClass>io.helix.mcp.HelixMcpMain</mainClass>
            </manifest>
            <manifestEntries>
              <Implementation-Title>${project.name}</Implementation-Title>
              <Implementation-Version>${project.version}</Implementation-Version>
              <Implementation-Vendor-Id>${project.groupId}</Implementation-Vendor-Id>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>io.helix.mcp.HelixMcpMain</mainClass>
                  <manifestEntries>
                    <Implementation-Title>${project.name}</Implementation-Title>
                    <Implementation-Version>${project.version}</Implementation-Version>
                    <Implementation-Vendor-Id>${project.groupId}</Implementation-Vendor-Id>
                  </manifestEntries>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
